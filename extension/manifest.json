{
  "manifest_version": 3,
  "name": "Second Brain",
  "version": "1.0",
  "description": "Save any page to your Second Brain",
  "permissions": ["contextMenus", "activeTab", "storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
